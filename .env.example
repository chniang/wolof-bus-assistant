NVIDIA_API_KEY=
# Optionnel : modèle NVIDIA Build (défaut nvidia/llama-3.1-nemotron-51b-instruct)
# LLM_MODEL=
# Optionnel : plafonds d'appels au LLM pour tout le Space (défauts 30 et 1000)
# LLM_MAX_PAR_MINUTE=
# LLM_MAX_PAR_JOUR=
# Optionnel : plafonds par client (défauts 5 et 50 pour le LLM, 10 et 100 pour les trajets)
# LLM_MAX_PAR_CLIENT_MINUTE=
# LLM_MAX_PAR_CLIENT_JOUR=
# TRAJETS_MAX_PAR_MINUTE=
# TRAJETS_MAX_PAR_JOUR=
# Optionnel : rang de l'adresse client depuis la fin de x-forwarded-for (défaut : début de liste)
# IP_PROXYS_CONFIANCE=
# Optionnel : collecte des voix de l'onglet Parler (éteinte par défaut)
# COLLECTE_ACTIVE=
# HF_TOKEN_COLLECTE=
# CONTACT_WHATSAPP=
# Plafonds de la collecte (défauts 5 voix par client et par heure, 200 par jour, 20 s, 30 avis par heure)
# COLLECTE_MAX_PAR_CLIENT_HEURE=
# COLLECTE_MAX_PAR_JOUR=
# COLLECTE_DUREE_MAX_S=
# COLLECTE_AVIS_MAX_PAR_CLIENT_HEURE=
